# HTTP listen port (1-65535)
PORT=8080

# Socket.IO allowed origin. Set a specific production frontend origin.
CORS_ORIGIN=*

# Directory containing static assets, relative to the process working directory.
PUBLIC_DIR=public

# Max size in bytes of a single socket.io message. Excalidraw broadcasts the
# whole scene on join / periodic full-sync; with many strokes it can exceed the
# socket.io 1MB default and the connection gets dropped.
MAX_HTTP_BUFFER_SIZE=5242880
